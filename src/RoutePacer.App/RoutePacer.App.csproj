<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The hosted publish does not run the client's HTML placeholder substitution, so a fingerprinted
         index.html would keep the literal #[.{fingerprint}] token and request a path that 404s. Cache
         invalidation comes from the service worker's versioned cache and asset manifest instead. -->
    <WasmFingerprintAssets>false</WasmFingerprintAssets>
    <StaticWebAssetFingerprintContent>false</StaticWebAssetFingerprintContent>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <ProjectReference Include="..\RoutePacer.Core\RoutePacer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

</Project>
