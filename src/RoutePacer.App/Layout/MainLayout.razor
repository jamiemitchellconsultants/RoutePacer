@inherits LayoutComponentBase

@* Three screens -- the route, importing one, and the tracker -- so there is nothing for a
   navigation menu to choose between. The brand is the only chrome: one line, few lit pixels, and
   it guarantees no screen is a dead end. *@
<div class="page">
    <header class="top-row">
        <a class="brand" href="">RoutePacer</a>
    </header>

    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>
