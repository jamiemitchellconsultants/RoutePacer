<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- A hosted Blazor WebAssembly app must be a normal ProjectReference. With ReferenceOutputAssembly="false"
         the server collects the source index.html and its fingerprint placeholders are never substituted, so the
         published page requests _framework/blazor.webassembly and the app does not boot. -->
    <ProjectReference Include="..\RoutePacer.App\RoutePacer.App.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
  </ItemGroup>

</Project>
